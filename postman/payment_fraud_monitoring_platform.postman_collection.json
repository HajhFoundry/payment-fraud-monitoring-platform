  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "POST Create Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Customer ID returned\", function () {\r",
                  "    pm.expect(jsonData.customer_id).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Email returned\", function () {\r",
                  "    pm.expect(jsonData.email).to.eql(\r",
                  "        pm.environment.get(\"customer_email\")\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\r",
                  "    \"customer_id\",\r",
                  "    jsonData.customer_id\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\r",
                  "    \"customer_email\",\r",
                  "    \"customer\" + Date.now() + \"@test.com\"\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"first_name\": \"John\",\r\n  \"last_name\": \"Smith\",\r\n  \"email\": \"{{customer_email}}\",\r\n  \"country\": \"Canada\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/customers/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers",
                ""
              ]
            }
          },
          "response": []
        }
      ]
    },
